{
  "name": "frontend",
  "version": "1.0.0",
  "description": "devgon - Code-first CMS framework for building scalable fullstack applications",
  "author": "devgon<devgonteam@gmail.com> - Gontar",
  "private": true,
  "license": "LICENSE",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently \"dotenv -e ../backend/.env.test -- npm run dev --prefix ../backend\" \"dotenv -e .env.test -- npm run dev\"",
    "test:e2e": "echo '✅ FRONTEND E2E TESTS' && playwright test --config test/e2e/config/playwright.config.ts",
    "test:seo": "echo '✅ FRONTEND SEO TEST' && (tsx test/seo/lighthouse.test.ts || echo 'SEO failed but ignored')",
    "ci:test": "start-server-and-test start:all \"http://localhost:3000|tcp:4000\" \"npm run test:e2e && npm run test:seo\"",
    "lint": "echo '🧹 LINTING FRONTEND' && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --list-different .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
