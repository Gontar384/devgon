{
  "name": "frontend",
  "version": "1.0.0",
  "description": "devgon's modular and innovative web project - visual layer",
  "author": "devgon<devgonteam@gmail.com> - Gontar",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "start:all": "concurrently \"dotenv -e ../backend/.env.test -- npm run dev --prefix ../backend\" \"npm run dev\"",
    "test:e2e": "start-server-and-test start:all http://localhost:3000 \"test:playwright\"",
    "test:playwright": "playwright test test/e2e",
    "test:seo": "node test/seo/lighthouse.test.js",
    "test": "npm run test:e2e && npm run test:seo",
    "test:all": "npm run test:playwright && (npm run test:seo || echo 'SEO failed but ignored')",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --list-different .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "axios": "1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.540.0",
    "next": "15.4.2",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "chrome-launcher": "^1.2.0",
    "concurrently": "^9.2.0",
    "cross-spawn": "^7.0.6",
    "dotenv-cli": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "lighthouse": "^12.8.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "start-server-and-test": "^2.0.12",
    "tailwindcss": "^4.1.11",
    "tree-kill": "^1.2.2",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.8.3"
  }
}
