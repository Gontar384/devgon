    "array-move": "^4.0.0",
    "axios": "1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.3.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "graphql": "^16.11.0",
