#====================================================
#                 .env | .env.test
#====================================================
# Environment (development / testing / production)
NODE_ENV=development
# Frontend and Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
# Used to sign JWT - generate in Powershell: -join ((1..32 | ForEach-Object { "{0:X2}" -f (Get-Random -Maximum 256) })).ToLower()
JWT_SECRET_KEY=
# Used while creating cookies e.g. '.test.site' (only in production)
COOKIE_DOMAIN=
# OAuth2 client credentials from GCP
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Database URL with credentials
DATABASE_URL=postgresql://postgres:password@localhost:5432/testDb
# Minio configuration with credentials (MINIO_PUBLIC_URL e.g. https://minio.test.site used only in production)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=media
MINIO_PUBLIC_URL=